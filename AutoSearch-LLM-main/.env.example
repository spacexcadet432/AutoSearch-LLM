# AutoSearch-LLM - environment variable NAMES only. Never put real values here.
# Local dev:  copy to `.env` (gitignored).
# Production: put these in /etc/autosearch/autosearch.env on EC2 (chmod 600).

# =====================================================================
# LOCAL DEVELOPMENT
# =====================================================================
# AUTOSEARCH_ENV=development          # enables /docs; default
# AUTOSEARCH_LOG_LEVEL=INFO
# AUTOSEARCH_ALLOWED_ORIGINS=*        # dev default; MUST be set explicitly in prod

# =====================================================================
# PRODUCTION / AWS  (required)
# =====================================================================
# AUTOSEARCH_ENV=production
# AUTOSEARCH_ALLOWED_ORIGINS=https://<your-app>.vercel.app,http://localhost:3000

# --- LLM: Amazon Bedrock (OpenAI-compatible endpoint) ---
# Only openai.gpt-oss-* models are served by Bedrock's OpenAI-compatible API.
AUTOSEARCH_LLM_BASE_URL=
AUTOSEARCH_LLM_MODEL=
AWS_BEARER_TOKEN_BEDROCK=

# Alternative to the bearer token: attach an EC2 IAM role with bedrock:InvokeModel.

# --- Web search ---
SERPER_API_KEY=

# =====================================================================
# OPTIONAL TUNING (defaults in backend/services/config.py)
# =====================================================================
# AUTOSEARCH_HOST=
# AUTOSEARCH_PORT=
# AUTOSEARCH_ENABLE_DOCS=
# AUTOSEARCH_LLM_TIMEOUT_S=
# AUTOSEARCH_LLM_MAX_RETRIES=
# AUTOSEARCH_SEARCH_TIMEOUT_S=
# AUTOSEARCH_SEARCH_MAX_ATTEMPTS=
# AUTOSEARCH_FETCH_TIMEOUT_S=
# AUTOSEARCH_FETCH_CONCURRENCY=
# AUTOSEARCH_RETRIEVAL_DEADLINE_MS=
# AUTOSEARCH_MAX_DOWNLOAD_BYTES=
# AUTOSEARCH_SEARCH_CACHE_ENABLED=
# AUTOSEARCH_SEARCH_CACHE_TTL_S=
# AUTOSEARCH_SEARCH_CACHE_MAX_ENTRIES=

# =====================================================================
# FRONTEND (Vercel project env vars, not this file)
# =====================================================================
# VITE_PUBLIC_BACKEND_URL=            # https URL of the EC2 backend, no trailing slash
