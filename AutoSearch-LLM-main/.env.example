# AutoSearch-LLM configuration.
# Copy to .env and fill in your two credentials:  cp .env.example .env
# Variable NAMES only - never commit real values. .env is gitignored.

# ---------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------

# --- LLM: Amazon Bedrock (OpenAI-compatible endpoint) ---
# Bedrock's OpenAI-compatible API serves only the openai.gpt-oss-* models.
AUTOSEARCH_LLM_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
AUTOSEARCH_LLM_MODEL=openai.gpt-oss-120b-1:0
AWS_BEARER_TOKEN_BEDROCK=

# --- Web search ---
# Free key from https://serper.dev
SERPER_API_KEY=

# ---------------------------------------------------------------------
# ALTERNATIVE: plain OpenAI instead of Bedrock
# ---------------------------------------------------------------------
# Leave AUTOSEARCH_LLM_BASE_URL unset and set:
# OPENAI_API_KEY=
# AUTOSEARCH_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
# OPTIONAL TUNING (defaults in backend/services/config.py)
# ---------------------------------------------------------------------
# AUTOSEARCH_LOG_LEVEL=INFO
# AUTOSEARCH_LLM_TIMEOUT_S=30
# AUTOSEARCH_LLM_MAX_RETRIES=2
# AUTOSEARCH_SEARCH_TIMEOUT_S=6
# AUTOSEARCH_SEARCH_MAX_ATTEMPTS=2
# AUTOSEARCH_FETCH_TIMEOUT_S=3
# AUTOSEARCH_FETCH_CONCURRENCY=4
# AUTOSEARCH_RETRIEVAL_DEADLINE_MS=3500
# AUTOSEARCH_SEARCH_CACHE_ENABLED=true
# AUTOSEARCH_SEARCH_CACHE_TTL_S=300
# AUTOSEARCH_SEARCH_CACHE_MAX_ENTRIES=256
