# Copy to /etc/autosearch/autosearch.env, then:
#   sudo chown root:root /etc/autosearch/autosearch.env
#   sudo chmod 600 /etc/autosearch/autosearch.env
# NEVER commit the real file.

# --- Runtime ---
AUTOSEARCH_ENV=production
AUTOSEARCH_LOG_LEVEL=INFO
# Comma-separated origins. Do NOT leave as * in production.
AUTOSEARCH_ALLOWED_ORIGINS=https://your-frontend.example.com

# --- LLM: Amazon Bedrock (OpenAI-compatible endpoint) ---
AUTOSEARCH_LLM_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
AUTOSEARCH_LLM_MODEL=openai.gpt-oss-120b-1:0
AWS_BEARER_TOKEN_BEDROCK=REPLACE_ME

# --- Web retrieval ---
SERPER_API_KEY=REPLACE_ME

# --- Timeouts (defaults shown; override only if needed) ---
# AUTOSEARCH_LLM_TIMEOUT_S=30
# AUTOSEARCH_SEARCH_TIMEOUT_S=6
# AUTOSEARCH_FETCH_TIMEOUT_S=3
# AUTOSEARCH_RETRIEVAL_DEADLINE_MS=3500

# --- Search cache ---
# AUTOSEARCH_SEARCH_CACHE_ENABLED=true
# AUTOSEARCH_SEARCH_CACHE_TTL_S=300
# AUTOSEARCH_SEARCH_CACHE_MAX_ENTRIES=256
