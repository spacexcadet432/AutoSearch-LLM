# AutoSearch-LLM systemd unit.
# Install: sudo cp deploy/autosearch.service /etc/systemd/system/
[Unit]
Description=AutoSearch-LLM API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=autosearch
Group=autosearch
WorkingDirectory=/opt/autosearch

# Secrets live here, root-owned and chmod 600 - never in this unit file
# and never in the repository.
EnvironmentFile=/etc/autosearch/autosearch.env

ExecStart=/opt/autosearch/.venv/bin/uvicorn backend.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --timeout-graceful-shutdown 30 \
    --proxy-headers

# Restart on crash and after reboot.
Restart=always
RestartSec=5
# SIGINT lets uvicorn drain in-flight requests before exiting.
KillSignal=SIGINT
TimeoutStopSec=40

# stdout/stderr go to the journal: journalctl -u autosearch
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autosearch

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
